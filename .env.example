# ---------------------------------------------------------------------------
# New Apostolic English High School — environment
# Copy to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Every one of these services has a free tier. Nothing here is paid.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadata, sitemap, canonical URLs, JSON-LD.
#
# Leave EMPTY on Vercel: the URL is resolved automatically from the project's
# production domain, which is the *.vercel.app address until a custom domain is
# attached and the custom domain from then on. Set it only to force a value.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# 1. FORM DELIVERY  (admission enquiry, contact, career, newsletter)
#    Configure ONE of the two options below. The first one present wins.
# ---------------------------------------------------------------------------

# Option A — Resend (free tier: 3,000 emails/month). https://resend.com
RESEND_API_KEY=""
# Verified sender on your domain, e.g. "Website <website@apostoliceducation.org>"
FORM_FROM_EMAIL="New Apostolic Website <onboarding@resend.dev>"
# Where enquiries land. Comma separated for multiple recipients.
FORM_TO_EMAIL="naehs_bajc@yahoo.com"

# Option B — Any HTTPS webhook that accepts JSON (Google Apps Script, Make,
# Zapier, n8n, Slack …). The full, validated submission is POSTed as JSON.
FORM_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# 2. SPAM PROTECTION (optional — a honeypot + timing check always run)
#    Cloudflare Turnstile is free and privacy friendly.
#    https://dash.cloudflare.com → Turnstile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# 3. DECAP CMS — GitHub authentication
#    Create an OAuth App at https://github.com/settings/developers
#    Homepage URL:            https://your-domain
#    Authorization callback:  https://your-domain/api/oauth/callback
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
# Optional: restrict logins to a single repository (owner/name).
GITHUB_OAUTH_REPO="riteshbhagat24/naes"
# OAuth scope. Defaults to `public_repo,user`, which is correct while
# github.com/riteshbhagat24/naes is public and keeps editors' private
# repositories out of reach of the CMS token.
# If the repository is ever made private, change this to: repo,user
GITHUB_OAUTH_SCOPE=""

